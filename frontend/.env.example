# Base URL of the FastAPI backend. Defaults to http://localhost:8000 if unset.
# Local dev needs no config — the backend's CORS defaults to http://localhost:3000.
# In production (Vercel), set this to your deployed backend URL, e.g.
#   NEXT_PUBLIC_API_URL=https://poshan-saathi-api.onrender.com
# and set CORS_ALLOW_ORIGINS on the backend to your Vercel URL. See DEPLOYMENT.md.
NEXT_PUBLIC_API_URL=http://localhost:8000
