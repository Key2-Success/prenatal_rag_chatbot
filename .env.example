# OpenAI — required.
# Used for: embeddings (text-embedding-3-small at ingest + query time),
# the answer LLM (gpt-4.1-nano), the classifier LLM, and the OpenAI
# embeddings inside the RAGAS judge for ResponseRelevancy.
OPENAI_API_KEY=your_openai_api_key_here

# LlamaCloud — required ONLY for `python -m scripts.ingest`.
# The runtime app reads from Pinecone and never calls LlamaParse.
# Free tier: 1000 pages/day — more than enough for this corpus.
# Sign up at https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=

# Anthropic — required ONLY for `python -m eval.ragas_eval`.
# RAGAS uses an LLM-as-judge to score answer quality. Best practice is a
# cross-vendor judge (Claude judging GPT) to avoid same-family bias —
# see .claude/skills/ragas/references/pitfalls.md #2. The rest of the app
# runs fine without this key.
ANTHROPIC_API_KEY=

# Pinecone — required.
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=poshan-saathi

# App
APP_ENV=development  # development | production

# HyDE — Hypothetical Document Embeddings (query transformation).
# When ON, the retriever uses a small LLM to generate a hypothetical answer
# to the query, then embeds THAT (instead of the raw query) for retrieval.
# A/B tested (May 2026): degraded scores on this corpus because (a) chunks
# are structured guidelines not prose, (b) bge-reranker-v2-m3 already does
# the work HyDE typically helps with, (c) profile personalisation in HyDE
# dilutes the embedding centroid. Default OFF. Eval CLI accepts --hyde to
# force ON or --no-hyde to force OFF, for A/B comparison.
HYDE_ENABLED=false

# Hybrid search alpha (optional — defaults to 0.75)
# Controls the dense-vs-sparse weighting in retrieval.
# 1.0 = pure dense (cosine similarity), 0.0 = pure BM25 keyword matching.
# 0.75 is Pinecone's recommended default for RAG. A/B test with eval:
#   HYBRID_ALPHA=1.0 python -m eval.ragas_eval  (pure dense, pre-hybrid baseline)
#   HYBRID_ALPHA=0.5 python -m eval.ragas_eval  (equal weight)
HYBRID_ALPHA=0.75

# Langfuse (observability — optional)
# Leave blank to disable. With keys set, the OpenAI client is auto-wrapped
# and every /chat call shows up as a trace tree (classifier → retrieve → answer)
# at https://cloud.langfuse.com (or your self-hosted host).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
